# ----------------------------------------------------------------------------
# SkinScan — variables d'environnement
# Copier ce fichier en `.env` (ou configurer sur Vercel/Render) et remplir.
# ----------------------------------------------------------------------------

# Neon Postgres (serverless). Récupérer la chaîne "pooled" depuis le dashboard Neon.
# Ex : postgres://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Clé API Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Modèle vision utilisé pour l'analyse (défaut sûr et économique)
GEMINI_MODEL=gemini-2.0-flash

# Secret de signature des sessions (JWT). Générer avec : openssl rand -base64 32
AUTH_SECRET=

# Quota de scans gratuits par mois (compte non premium)
FREE_SCANS_PER_MONTH=5

# URL publique de l'app (utilisée pour le partage / watermark). Optionnel en local.
NEXT_PUBLIC_APP_URL=http://localhost:3000
