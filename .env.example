# ─────────────────────────────────────────────────────────────
# Nextiaa Voice — variables d'environnement (exemple)
# Copier ce fichier en .env puis renseigner GEMINI_API_KEY.
# Ne JAMAIS committer .env (voir .gitignore).
# ─────────────────────────────────────────────────────────────

# Base de données PostgreSQL (Neon). Chaîne de connexion depuis neon.tech.
# Ex : postgresql://user:pass@ep-xxx-pooler.<region>.aws.neon.tech/neondb?sslmode=require
# IMPORTANT : reste UNIQUEMENT côté serveur. En prod, à définir dans Render.
DATABASE_URL=

# Clé API Google AI Studio (niveau GRATUIT). Obtenir sur https://aistudio.google.com/apikey
# IMPORTANT : cette clé reste UNIQUEMENT côté serveur, jamais dans le navigateur.
GEMINI_API_KEY=

# Modèle Live à utiliser. Point de départ (à reconfirmer via la doc, voir docs/GEMINI_NOTES.md).
# Alternative : gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Voix prédéfinie de l'assistant (ex : Kore, Puck, Charon, Aoede, Fenrir…)
GEMINI_VOICE=Kore

# Durée de silence (ms) avant que le VAD considère la fin de parole (500–800 recommandé)
VAD_SILENCE_MS=700

# Durée maximale d'un appel en minutes
MAX_CALL_MINUTES=10

# Numéros de démo qui joignent l'assistant (séparés par des virgules)
DEMO_NUMBERS=8000

# Code USSD simulé qui ouvre le menu Nextiaa Voice
USSD_CODE=#136#

# Mot de passe simple de la console (usage LOCAL uniquement)
CONSOLE_PASSWORD=change-moi

# Port du serveur Node (le web Vite proxifie /api et /ws vers ce port)
PORT=8787

# Fuseau horaire injecté dans les instructions système
TIMEZONE=Africa/Douala
