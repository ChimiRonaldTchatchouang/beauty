# ----------------------------------------------------------------------------
# SkinScan B2B — variables d'environnement
# Copier en `.env` (local) et/ou configurer sur Vercel.
# ----------------------------------------------------------------------------

# --- Neon (Postgres serverless) : chaîne "Pooled" du dashboard Neon ---
DATABASE_URL=

# --- Google Gemini (vision) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Resend (emails de résultats) ---
RESEND_API_KEY=
# Adresse d'expéditeur sur un domaine VÉRIFIÉ dans Resend
RESEND_FROM="SkinScan <resultats@ton-domaine.com>"

# --- Sessions (JWT) : openssl rand -base64 32 ---
AUTH_SECRET=

# --- Google OAuth (connexion patients / centres / admin) ---
# Console Google Cloud → Credentials → OAuth client ID (Web application)
# Redirect URI à autoriser : <NEXT_PUBLIC_APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Emails autorisés comme super-admin plateforme (login Google admin, optionnel) ---
SUPER_ADMIN_EMAILS=

# --- Compte admin email + mot de passe (provisionné au déploiement) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- URL publique de l'app (IMPORTANT : sert au redirect OAuth + liens emails) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
