{
  "name": "nextiaa-voice",
  "version": "0.1.0",
  "private": true,
  "description": "Nextiaa Voice — assistant vocal IA voix-à-voix (Gemini Live), téléphone simulé dans le navigateur. Démo — données fictives uniquement.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace @nextiaa/server",
    "dev:web": "npm run dev --workspace @nextiaa/web",
    "build": "npm run build --workspace @nextiaa/shared && npm run build --workspace @nextiaa/server && npm run build --workspace @nextiaa/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "kb:import": "npm run kb:import --workspace @nextiaa/server --",
    "db:seed": "npm run db:seed --workspace @nextiaa/server"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "concurrently": "^9.1.0",
    "eslint": "^8.57.1",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
